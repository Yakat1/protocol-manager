rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isMember(labId) {
      return isAuth() && exists(/databases/$(database)/documents/labs/$(labId)/members/$(request.auth.uid));
    }

    function getMemberRole(labId) {
      return get(/databases/$(database)/documents/labs/$(labId)/members/$(request.auth.uid)).data.role;
    }

    function isAdmin(labId) {
      return isMember(labId) && getMemberRole(labId) == 'admin';
    }

    // Membership gate: self-enrollment only via a valid invitation.
    // El inviteId viene en request.resource.data. En vez de get() (que en este
    // contexto de create sobre members puede fallar por no tener allow get en
    // pendingInvites), validamos por email + role directamente en el member doc
    // que se está creando: el usuario solo puede unirse si su email coincide con
    // una invitación pendiente. La verificación del doc pendiente se hace
    // confiando en que solo el admin puede crearla y el invitee borrarla.
    function hasValidInvitation(labId, inviteId) {
      let email = request.auth.token.email;
      return email is string
          && email.size() > 0
          && inviteId is string
          && inviteId.size() > 0
          && request.resource.data.email == email
          && request.resource.data.role in ['admin', 'student'];
    }

    // Lab-bootstrap path: the person who created the lab's meta/info is its first admin.
    function isLabCreator(labId) {
      return exists(/databases/$(database)/documents/labs/$(labId)/meta/info)
          && get(/databases/$(database)/documents/labs/$(labId)/meta/info).data.createdBy == request.auth.uid;
    }

    // ─── User Profiles ──────────────────────────────────────
    // Readable/writable only by the profile owner (no user-directory leak).
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ─── Legacy Protocols (migration) ───────────────────────
    match /protocols/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ─── Pending Invitations (collection-group INBOX) ─────────────────────
    // Una collection-group query (el inbox del invitee) SOLO funciona si hay
    // una regla con wildcard {path=**} que matchee la subcolección a cualquier
    // profundidad. La regla anidada bajo /labs/{labId} solo cubre acceso
    // directo. No puede usar get()/exists() para la collection-group query.
    match /{path=**}/pendingInvites/{inviteId} {
      allow read: if isAuth() && resource.data.email == request.auth.token.email;
    }

    // ─── Labs ───────────────────────────────────────────────
    match /labs/{labId} {

      // Presence: quién está editando ahora (heartbeat por usuario)
      match /editors/{uid} {
        allow read: if isMember(labId);
        allow create, update, delete: if isMember(labId) && request.auth.uid == uid;
      }

      // Members subcollection: self-enrollment only via a valid invitation
      // (role must match the invite) or as the lab's bootstrap creator.
      match /members/{memberId} {
        allow read: if isMember(labId);
        allow create: if isOwner(memberId)
                   && request.resource.data.role in ['admin', 'student']
                   && (isLabCreator(labId)
                       || ('inviteId' in request.resource.data
                           && hasValidInvitation(labId, request.resource.data.inviteId)));
        allow update, delete: if isAdmin(labId);
      }

      // Pending invitations (acceso DIRECTO): el admin lee/escribe/borra
      // (necesario para el chequeo de duplicados por emailKey); el invitee
      // lee/borra su propio doc. La lectura del INVITEE por collection-group
      // (inbox) la cubre la regla raíz {path=**} de arriba — no esta.
      match /pendingInvites/{inviteId} {
        allow read: if isAdmin(labId)
                 || (isAuth() && resource.data.email == request.auth.token.email);
        allow create, update: if isAdmin(labId);
        allow delete: if isAuth() && (isAdmin(labId) || resource.data.email == request.auth.token.email);
      }

      // Lab metadata (info + shared state)
      match /meta/{docId} {
        allow read: if isMember(labId);
        allow create, update: if isMember(labId);
        allow delete: if isAdmin(labId);
      }

      // Lab creation bootstrap: the creator writes meta/info BEFORE their own member doc.
      // (Rules-side get()/exists() are evaluated by the engine regardless of allow-read.)
      match /meta/info {
        allow read: if isMember(labId);
        allow create: if isAuth()
                   && request.resource.data.createdBy == request.auth.uid
                   && !exists(/databases/$(database)/documents/labs/$(labId)/meta/info);
        allow update: if isMember(labId);
        allow delete: if isAdmin(labId);
      }

      // Audit log — APPEND-ONLY (create only, no update/delete)
      match /auditLog/{entryId} {
        allow read: if isMember(labId);
        allow create: if isMember(labId);
      }

      // Personal logs (bitácora): members create/read; owner or admin updates; admin deletes.
      match /personalLogs/{logId} {
        allow read: if isMember(labId);
        allow create: if isMember(labId);
        allow update: if isMember(labId)
                   && (isAdmin(labId) || resource.data.userId == request.auth.uid);
        allow delete: if isAdmin(labId);
      }
    }
  }
}